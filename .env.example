# ─────────────────────────────────────────────────────────────────────────────
# Sharded-Docstore — environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Cluster authentication ────────────────────────────────────────────────────
# Shared secret used for inter-node HMAC authentication (min 32 chars).
CLUSTER_SECRET=change-me-cluster-secret-min-32-chars

# Admin token for coordinator admin endpoints (separate from cluster secret).
ADMIN_TOKEN=change-me-admin-token-min-32-chars

# API key required by clients hitting the router.
CLIENT_API_KEY=change-me-client-api-key

# ── Port assignments ──────────────────────────────────────────────────────────
COORDINATOR_PORT=8000
ROUTER_PORT=8100

# Shard 0
SHARD0_PRIMARY_PORT=8200
SHARD0_FOLLOWER_PORT=8201

# Shard 1
SHARD1_PRIMARY_PORT=8210
SHARD1_FOLLOWER_PORT=8211

# Shard 2
SHARD2_PRIMARY_PORT=8220
SHARD2_FOLLOWER_PORT=8221

# ── Timing parameters ─────────────────────────────────────────────────────────
# Heartbeat interval in seconds. Must satisfy H < L < D.
HEARTBEAT_INTERVAL_S=1.0

# Lease duration in seconds.
LEASE_DURATION_S=3.0

# Failure-detection timeout in seconds.
FAILURE_TIMEOUT_S=5.0

# Safety margin in seconds (M); a write needs remaining lease > T + M.
SAFETY_MARGIN_S=0.5

# Replication timeout in seconds (T). Startup validates T + M < L - H.
REPLICATION_TIMEOUT_S=1.0

# ── Storage ───────────────────────────────────────────────────────────────────
# Base directory for WAL files and snapshots (per-node subdirs are created here).
DATA_DIR=./data

# Periodic snapshot cadence; each snapshot is followed by safe WAL compaction.
# A snapshot is taken after N applied ops or S seconds (whichever comes first).
SNAPSHOT_EVERY_N_OPS=1000
SNAPSHOT_EVERY_S=60

# ── Feature flags ────────────────────────────────────────────────────────────
# Enable crash-point test hooks (NEVER true in production).
ENABLE_TEST_HOOKS=false

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
